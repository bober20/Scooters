<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.SearchCustomView"
             xmlns:local="clr-namespace:MauiApp1"
             x:DataType="local:SearchCustomView">
    <Grid
        InputTransparent="False"
        RowDefinitions="*">
        <Entry 
            Keyboard="{x:Static Keyboard.Plain}"
            IsTextPredictionEnabled="False"
            IsSpellCheckEnabled="False"
            Text="{Binding EntryText, Mode=TwoWay}" />
        <AbsoluteLayout
            AbsoluteLayout.LayoutFlags="WidthProportional"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            HeightRequest="0"
            Margin="0,40,0,0">
            <Border
                BackgroundColor="Aquamarine"
                WidthRequest="{Binding Width, Source={RelativeSource AncestorType={x:Type Grid}}}"
                StrokeShape="RoundRectangle 10 10"
                Padding="10">
                <CollectionView
                    ItemsSource="{Binding FilteredItems}" />
            </Border>
        </AbsoluteLayout>
    </Grid>
</ContentView>