<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.RideView"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:RideViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <VerticalStackLayout>
            <Label Text="{Binding Ride.Id}"></Label>
            <Label Text="{Binding Countdown}"></Label>
            <Button 
                Text="End ride"
                Command="{Binding EndRideCommand}" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>