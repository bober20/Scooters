<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.ProfilePage"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:ProfileViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}"/>
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <Grid
            RowSpan="3"
            Padding="20"
            RowDefinitions="4*, Auto, Auto"
            RowSpacing="20">
            <Border
                Grid.Row="0"
                StrokeThickness="3"
                StrokeShape="Ellipse"
                HeightRequest="240"
                WidthRequest="240"
                HorizontalOptions="Center">
                <ImageButton 
                    Aspect="Fill"
                    Source="man_profile.jpg"
                    Command="{Binding UploadPhotoCommand}"/>
            </Border>
            <Label 
                Grid.Row="1" 
                Text="{Binding User.Email}"
                FontSize="22"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"/>
            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 50 50"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="20">
                <VerticalStackLayout Spacing="20" Padding="20">
                        <FlexLayout
                            JustifyContent="SpaceBetween"
                            AlignItems="Center"
                            Margin="0"
                            Padding="0">
                            <Label
                                Text="Dark mode" />
                            <Switch
                                OnColor="LightGray"
                                ThumbColor="Grey"
                                IsToggled="{Binding IsDarkMode}" />
                        </FlexLayout>
                    <Border 
                        Margin="-10, 0"
                        StrokeThickness="1"/>
                    <Label
                        Text="Change password"
                        VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordLinkCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Border 
                        Margin="-10, 0"
                        StrokeThickness="1"/>
                    <Label
                        Text="Delete account"
                        TextColor="Red"
                        VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Border 
                        Margin="-10, 0"
                        StrokeThickness="1"/>
                    <Button
                        CornerRadius="10"
                        Text="Log out"
                        Command="{Binding LogOutCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>