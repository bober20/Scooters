<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.ProfilePage"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:ProfileViewModel">
    <ContentPage.Content>
        <Grid 
            RowSpan="6" 
            RowDefinitions="5*, *, *, *, *, 2*" 
            Padding="20"
            RowSpacing="20">
            <Border 
                Grid.Row="0"
                Margin="-20,-20,-20,0">
                <Image/>
            </Border>
            <FlexLayout
                Grid.Row="1"
                JustifyContent="SpaceBetween"
                AlignItems="Center"
                Margin="0"
                Padding="0">
                <Label 
                    Text="Dark mode"/>
                <Switch 
                    OnColor="LightGray"
                    ThumbColor="Grey"
                    IsToggled="{Binding IsDarkMode}"/>
            </FlexLayout>
            <Label 
                Grid.Row="2" 
                Text="Change password"
                VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangePasswordLinkCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label 
                Grid.Row="3" 
                Text="Upload new profile picture"
                VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UploadPhotoCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label 
                Grid.Row="4" 
                Text="Delete account"
                TextColor="Red"
                VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Button 
                BackgroundColor="Black" 
                CornerRadius="10" Grid.Row="5" 
                Text="Log out" 
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Command="{Binding LogOutCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>