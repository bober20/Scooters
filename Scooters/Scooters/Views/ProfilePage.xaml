<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.ProfilePage"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:ProfileViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <Grid
            RowSpan="2"
            RowDefinitions="Auto,*"
            RowSpacing="20">
            <VerticalStackLayout
                Margin="15"
                Grid.Row="0"
                Spacing="10">
                <Border
                    StrokeThickness="3"
                    StrokeShape="Ellipse"
                    HeightRequest="240"
                    WidthRequest="240"
                    HorizontalOptions="Center">
                    <ImageButton
                        Aspect="AspectFill"
                        Source="{Binding ProfileImage}"
                        Command="{Binding PhotoManagementCommand}" />
                </Border>
                <Label
                    Text="{Binding User.Email}"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </VerticalStackLayout>
            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 40 40 0 0"
                    StrokeThickness="0"
                    Padding="10">
                <FlexLayout
                    JustifyContent="SpaceBetween"
                    Direction="Column">
                    <VerticalStackLayout
                        Spacing="20"
                        Padding="20">
                        <Label
                            Text="Change password"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangePasswordLinkCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Border
                            StrokeThickness="0.5"
                            Margin="-10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter
                                        Property="BackgroundColor"
                                        Value="{AppThemeBinding 
                                                        Light={StaticResource Black}, 
                                                        Dark={StaticResource White}}" />
                                </Style>
                            </Border.Style>
                        </Border>
                        <Label
                            Text="Log out"
                            TextColor="Red"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogOutCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Border
                            StrokeThickness="0.5"
                            Margin="-10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter
                                        Property="BackgroundColor"
                                        Value="{AppThemeBinding 
                                                        Light={StaticResource Black}, 
                                                        Dark={StaticResource White}}" />
                                </Style>
                            </Border.Style>
                        </Border>
                        <Label
                            Text="Delete account"
                            TextColor="Red"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Border
                            StrokeThickness="0.5"
                            Margin="-10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter
                                        Property="BackgroundColor"
                                        Value="{AppThemeBinding 
                                                        Light={StaticResource Black}, 
                                                        Dark={StaticResource White}}" />
                                </Style>
                            </Border.Style>
                        </Border>
                    </VerticalStackLayout>
                </FlexLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>