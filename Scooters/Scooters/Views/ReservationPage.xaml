<?xml version="1.0" encoding="utf-8"?>

<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               x:Class="Scooters.Views.ReservationPage"
               xmlns:viewModels="clr-namespace:Scooters.ViewModels"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:DataType="viewModels:ReservationViewModel"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Opened="ReservationPage_OnOpened"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               Size="500, 700"
               xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
               ios:Page.UseSafeArea="True"
               Shell.TabBarIsVisible="False"
               Shell.FlyoutItemIsVisible="False"
               Color="Transparent">
    <ScrollView>
        <VerticalStackLayout Spacing="10">
            <Border
                StrokeShape="RoundRectangle 40 40 0 0">
                <VerticalStackLayout
                    Margin="0,10"
                    Spacing="5"
                    Padding="20">
                    <VerticalStackLayout>
                        <Border
                            StrokeThickness="0">
                            <Image
                                Source="scooter.png"
                                WidthRequest="280"
                                HeightRequest="280">
                            </Image>
                        </Border>
                        <HorizontalStackLayout Spacing="15">
                            <Label Padding="5">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            Text="&#xe71c;"
                                            FontFamily="MauiMaterialAssets" />
                                        <Span Text="{Binding Scooter.Coordinates.Latitude}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Padding="5">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            Text="&#xe71e;"
                                            FontFamily="MauiMaterialAssets" />
                                        <Span Text="80%" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Scooter.ModelDescription}"
                            FontSize="26" />
                        <Label
                            Text="$10/hour"
                            TextColor="DimGrey"
                            FontSize="20" />
                    </VerticalStackLayout>
                    <Border Margin="0,10" />
                    <FlexLayout JustifyContent="SpaceAround" AlignContent="Center">
                        <VerticalStackLayout>
                            <Label
                                HorizontalTextAlignment="Center"
                                TextColor="DimGrey"
                                Text="Distance to the scooter" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="26"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Distance}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label
                                HorizontalTextAlignment="Center"
                                TextColor="DimGrey"
                                Text="Max. Load" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="26"
                                HorizontalTextAlignment="Center"
                                Text="110 kg" />
                        </VerticalStackLayout>
                    </FlexLayout>
                    <VerticalStackLayout
                        Margin="0,20,0,0"
                        Spacing="5">
                        <Label
                            Text="Select time interval for reservation (min)"
                            FontAttributes="Bold"
                            FontSize="18" />
                        <Picker
                            Title="Select time interval"
                            ItemsSource="{Binding TimeSlots}"
                            SelectedItem="{Binding Reservation.Duration}" />
                        <Button
                            Text="Reserve"
                            Command="{Binding ReserveScooterCommand}">
                        </Button>
                        <Button
                            Text="Ride straight away"
                            Command="{Binding RideLinkCommand}">
                        </Button>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>