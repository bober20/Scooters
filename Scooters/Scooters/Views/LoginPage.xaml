<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:LoginViewModel">
    <ContentPage.Content>
        <Grid IgnoreSafeArea="True"
              RowSpan="2"
              RowDefinitions="Auto, *">
            <Label 
                Grid.Row="0"
                Padding="20, 80, 20, 40"
                Text="Scooters"
                HorizontalTextAlignment="Center"
                FontSize="72"
                FontAttributes="Bold"/>
            <Border 
                Grid.Row="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 50 50">
                <VerticalStackLayout Spacing="20" Padding="20, 40, 20, 10">
                    <Label
                        Text="Sign in"
                        FontSize="32"
                        FontAttributes="Bold"/>
                    <Entry 
                        Placeholder="Email"
                        BackgroundColor="White"
                        Text="{Binding Email}"/>
                    <Entry
                        Placeholder="Password"
                        BackgroundColor="White"
                        Text="{Binding Password}"/>
                    <Button
                        Text="Log in"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        CornerRadius="10"
                        Command="{Binding LogInCommand}"/>
                    <Label
                        Text="{Binding Errors}"
                        TextColor="Red"/>
                    <Label
                        HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Don't have an account? " TextColor="Black" />
                                <Span Text="Sign up" 
                                      TextColor="DarkCyan">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SignUpLinkCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>