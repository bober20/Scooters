<?xml version="1.0" encoding="utf-8"?>

<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               x:Class="Scooters.Views.InstructionsPopUp"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               CanBeDismissedByTappingOutsideOfPopup="True"
               xmlns:viewModels="clr-namespace:Scooters.ViewModels"
               x:DataType="viewModels:InstructionsViewModel"
               Color="Transparent">
    <VerticalStackLayout>
        <Border 
            StrokeShape="RoundRectangle 40 40" 
            Margin="20">
            <VerticalStackLayout
                VerticalOptions="Fill"
                Padding="20"
                Spacing="10">
                <Label
                    FontSize="30"
                    Text="App manual"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
                <Label
                    Text="To reserve a scooter simply click on a pin. Then choose reservation duration and click on the 'Reserve' button."
                    FontSize="20" />
                <Label
                    Text="To ride a scooter scan its QR code, then click  on the 'Ride straight away' button."
                    FontSize="20" />
                <Button
                    Text="OK"
                    Command="{Binding CloseCommand}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</toolkit:Popup>