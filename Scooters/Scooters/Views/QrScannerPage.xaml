<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.QrScannerPage"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             xmlns:maui="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.MAUI"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:DataType="viewModels:QrScannerViewModel"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <zxing:CameraBarcodeReaderView
            IsEnabled="{Binding IsEnabled}"
            x:Name="Scanner"
            IsDetecting="{Binding IsDetecting}">
            <zxing:CameraBarcodeReaderView.Options>
                <maui:BarcodeReaderOptions
                    Formats="QrCode"
                    AutoRotate="True" />
            </zxing:CameraBarcodeReaderView.Options>
            <zxing:CameraBarcodeReaderView.Behaviors>
                <toolkit:EventToCommandBehavior
                    x:TypeArguments="system:EventArgs"
                    Command="{Binding BarcodeDetectedCommand}"
                    EventName="BarcodesDetected" />
            </zxing:CameraBarcodeReaderView.Behaviors>
        </zxing:CameraBarcodeReaderView>
    </ContentPage.Content>
</ContentPage>