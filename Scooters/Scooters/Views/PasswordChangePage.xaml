<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.PasswordChangePage"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:PasswordChangeViewModel">
    <ContentPage.Content>
        <Grid
            RowSpan="3"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="10">
            <Label
                Grid.Row="0"
                Text="Change password"
                HorizontalTextAlignment="Center"
                FontSize="32"
                FontAttributes="Bold"
                Margin="10" />
            <Label
                Grid.Row="1"
                Text="Create new and strong password to protect your account."
                HorizontalTextAlignment="Justify"
                FontSize="18"
                Margin="10" />
            <Border
                Grid.Row="2"
                StrokeShape="RoundRectangle 50 50 0 0"
                Padding="20,20,20,30">
                <VerticalStackLayout Spacing="20">
                    <Label
                        Text="Create password"
                        HorizontalTextAlignment="Center"
                        FontSize="32"
                        FontAttributes="Bold" />
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Old password" />
                        <FlexLayout>
                            <Entry
                                Text="{Binding OldPassword, Mode=TwoWay}"
                                Placeholder="Old password"
                                IsPassword="{Binding IsPasswordVisible}"
                                FlexLayout.Basis="0"
                                FlexLayout.Grow="1">
                                <Entry.Triggers>
                                    <DataTrigger
                                        TargetType="Entry"
                                        Binding="{Binding OldPassHasErrors}"
                                        Value="True">
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="{StaticResource Error}">
                                        </Setter>
                                    </DataTrigger>
                                </Entry.Triggers>
                            </Entry>
                            <Button
                                BackgroundColor="Transparent"
                                FontFamily="MauiMaterialAssets"
                                TextColor="DimGrey"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Text="&#xe758;">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsPasswordVisible}"
                                        Value="True">
                                        <Setter
                                            Property="Text"
                                            Value="&#xe78e;" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                        <Label
                            Text="{Binding OldPasswordErrors}"
                            TextColor="{StaticResource ErrorText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="New password" />
                        <FlexLayout>
                            <Entry
                                Text="{Binding NewPassword, Mode=TwoWay}"
                                Placeholder="New password"
                                IsPassword="{Binding IsPasswordVisible}"
                                FlexLayout.Basis="0"
                                FlexLayout.Grow="1">
                                <Entry.Triggers>
                                    <DataTrigger
                                        TargetType="Entry"
                                        Binding="{Binding NewPassHasErrors}"
                                        Value="True">
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="{StaticResource Error}" />
                                    </DataTrigger>
                                </Entry.Triggers>
                            </Entry>
                            <Button
                                BackgroundColor="Transparent"
                                FontFamily="MauiMaterialAssets"
                                TextColor="DimGrey"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Text="&#xe758;">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsPasswordVisible}"
                                        Value="True">
                                        <Setter
                                            Property="Text"
                                            Value="&#xe78e;" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                        <Label
                            Text="Use uppercase letters, numbers and special characters"
                            TextColor="DimGrey"
                            FontSize="10" />
                        <Label
                            Text="{Binding NewPasswordErrors}"
                            TextColor="{StaticResource ErrorText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="New password confirmation" />
                        <FlexLayout>
                            <Entry
                                Text="{Binding NewPasswordConfirmation, Mode=TwoWay}"
                                Placeholder="New password confirmation"
                                FlexLayout.Basis="0"
                                FlexLayout.Grow="1"
                                IsPassword="{Binding IsPasswordVisible}">
                                <Entry.Triggers>
                                    <DataTrigger
                                        TargetType="Entry"
                                        Binding="{Binding NewPassConfirmHasErrors}"
                                        Value="True">
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="{StaticResource Error}">
                                        </Setter>
                                    </DataTrigger>
                                </Entry.Triggers>
                            </Entry>
                            <Button
                                BackgroundColor="Transparent"
                                FontFamily="MauiMaterialAssets"
                                TextColor="DimGrey"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Text="&#xe758;">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsPasswordVisible}"
                                        Value="True">
                                        <Setter
                                            Property="Text"
                                            Value="&#xe78e;" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                        <Label
                            Text="Password confirmation must match password"
                            TextColor="DimGrey"
                            FontSize="10" />
                        <Label
                            Text="{Binding NewPasswordConfirmationErrors}"
                            TextColor="{StaticResource ErrorText}" />
                    </VerticalStackLayout>
                    <Button
                        Text="Change password"
                        Command="{Binding ChangePasswordCommand}"
                        CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>