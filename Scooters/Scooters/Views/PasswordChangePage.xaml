<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.PasswordChangePage"
             xmlns:viewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="viewModels:PasswordChangeViewModel">
    <ContentPage.Content>
        <Grid
            RowSpan="3"
            RowDefinitions="Auto, Auto, Auto, Auto"
            Padding="20, 20, 20, 10"
            RowSpacing="10">
            <Label
                Grid.Row="0"
                Text="Change password"
                HorizontalTextAlignment="Center"
                FontSize="32"
                FontAttributes="Bold"
                Margin="0, 0, 0, 10" />
            <Label
                Grid.Row="1"
                Text="Password must consist of more than 8 symbols"
                HorizontalTextAlignment="Justify"
                FontSize="18"
                Margin="0, 0, 0, 10" />
            <Border
                Grid.Row="2"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 50 50"
                StrokeThickness="0"
                Padding="20, 20, 20, 30">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Create password"
                        HorizontalTextAlignment="Center"
                        FontSize="32"
                        FontAttributes="Bold" />
                    <Label Text="Old password" Margin="0, 0, 0, -5" />
                    <FlexLayout
                        Margin="0, 0, 0, 5">
                        <Entry
                            Text="{Binding OldPassword}"
                            Placeholder="Old password"
                            BackgroundColor="White"
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Margin="0, 0, 5, 0"/>
                        <Button
                            Text="P"/>
                    </FlexLayout>
                    <Label Text="New password" Margin="0, 0, 0, -5" />
                    <FlexLayout
                        Margin="0, 0, 0, 5">
                        <Entry
                            Text="{Binding NewPassword}"
                            Placeholder="New password"
                            BackgroundColor="White"
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Margin="0, 0, 5, 0"/>
                        <Button
                            Text="P" />
                    </FlexLayout>
                    <Label Text="New password confirmation" Margin="0, 0, 0, -5" />
                    <FlexLayout
                        Margin="0, 0, 0, 5">
                        <Entry
                            Text="{Binding NewPasswordConfirmation}"
                            Placeholder="New password confirmation"
                            BackgroundColor="White" 
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Margin="0, 0, 5, 0"/>
                        <Button
                            Text="P"/>
                    </FlexLayout>
                    <Button
                        Text="Change password"
                        Command="{Binding ChangePasswordCommand}"
                        CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>