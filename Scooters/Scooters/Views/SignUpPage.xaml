<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.SignUpPage"
             Shell.NavBarIsVisible="False"
             xmlns:vewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="vewModels:SignUpViewModel">
    <ContentPage.Content>
        <Grid RowSpan="2" 
              RowDefinitions="Auto, *"
              IgnoreSafeArea="True">
            <Label Grid.Row="0"
                   Padding="20, 80, 20, 40"
                   Text="Scooters"
                   HorizontalTextAlignment="Center"
                   FontSize="72"
                   FontAttributes="Bold" />
            <Border 
                Grid.Row="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 50 50">
                <VerticalStackLayout
                    Spacing="20" 
                    Padding="20, 40, 20, 10">
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="Sign up"
                        FontSize="32"
                        FontAttributes="Bold" />
                    <Label Margin="0, 0, 0, -15"
                           Text="Email"
                           TextColor="DimGrey" />
                    <Entry
                        Placeholder="Email"
                        BackgroundColor="White"
                        Text="{Binding Email}" />
                    <Label Margin="0, 0, 0, -15"
                           Text="Password"
                           TextColor="DimGrey" />
                    <FlexLayout>
                        <Entry
                            Placeholder="Password"
                            BackgroundColor="White"
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Margin="0, 0, 5, 0"
                            Text="{Binding Password}"/>
                        <Button
                            Text="P"/>
                    </FlexLayout>
                    <Label Margin="0, 0, 0, -15"
                           Text="Password confirmation"
                           TextColor="DimGrey" />
                    <FlexLayout>
                        <Entry
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Placeholder="Password confirmation"
                            BackgroundColor="White"
                            Margin="0, 0, 5, 0"
                            Text="{Binding PasswordConfirmation}" />
                        <Button
                            Text="P"/>
                    </FlexLayout>
                    <Button
                        Text="Sign up"
                        CornerRadius="10"
                        Command="{Binding SignUpCommand}" />
                    <Label
                        Text="{Binding Errors}"
                        TextColor="Red">
                    </Label>
                    <Label
                        HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    Text="Already have an account? "
                                    TextColor="Black" />
                                <Span
                                    Text="Sign in"
                                    TextColor="DarkCyan">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LogInLinkCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>