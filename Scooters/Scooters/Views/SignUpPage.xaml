<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.Views.SignUpPage"
             Shell.NavBarIsVisible="False"
             xmlns:vewModels="clr-namespace:Scooters.ViewModels"
             x:DataType="vewModels:SignUpViewModel">
    <ContentPage.Content>
        <Grid RowSpan="2" 
              RowDefinitions="Auto, *"
              IgnoreSafeArea="True">
            <Label Grid.Row="0"
                   Padding="20, 80, 20, 40"
                   Text="Scooters"
                   HorizontalTextAlignment="Center"
                   FontSize="72"
                   FontAttributes="Bold" />
            <Border 
                Grid.Row="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 50 50">
                <VerticalStackLayout
                    Spacing="20" 
                    Padding="20, 40, 20, 10">
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="Sign up"
                        FontSize="32"
                        FontAttributes="Bold" />
                    <Label Margin="0, 0, 0, -15"
                           Text="Email"
                           TextColor="DimGrey" />
                    <Entry
                        Placeholder="Email"
                        BackgroundColor="White"
                        Text="{Binding Email}">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding EmailHasErrors}"
                                Value="True">
                                <Setter 
                                    Property="BackgroundColor" 
                                    Value="{StaticResource Error}"/>
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label 
                        Text="{Binding EmailErrors}"
                        TextColor="{StaticResource ErrorText}"
                        Margin="0, -15, 0, 0"/>
                    <Label Margin="0, 0, 0, -15"
                           Text="Password"
                           TextColor="DimGrey" />
                    <FlexLayout>
                        <Entry
                            Placeholder="Password"
                            BackgroundColor="White"
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            IsPassword="{Binding IsPasswordVisible}"
                            Margin="0, 0, 5, 0"
                            Text="{Binding Password}">
                            <Entry.Triggers>
                                <DataTrigger
                                    TargetType="Entry"
                                    Binding="{Binding PasswordHasErrors}"
                                    Value="True">
                                    <Setter 
                                        Property="BackgroundColor" 
                                        Value="{StaticResource Error}"/>
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                        <Button
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            Text="P"/>
                    </FlexLayout>
                    <Label 
                        Text="{Binding PasswordErrors}"
                        TextColor="{StaticResource ErrorText}"
                        Margin="0, -15, 0, 0"/>
                    <Label Margin="0, 0, 0, -15"
                           Text="Password confirmation"
                           TextColor="DimGrey" />
                    <FlexLayout>
                        <Entry
                            FlexLayout.Basis="0"
                            FlexLayout.Grow="1"
                            Placeholder="Password confirmation"
                            IsPassword="{Binding IsPasswordVisible}"
                            BackgroundColor="White"
                            Margin="0, 0, 5, 0"
                            Text="{Binding PasswordConfirmation}">
                            <Entry.Triggers>
                                <DataTrigger
                                    TargetType="Entry"
                                    Binding="{Binding PasswordConfirmHasErrors}"
                                    Value="True">
                                    <Setter 
                                        Property="BackgroundColor" 
                                        Value="{StaticResource Error}"/>
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                        <Button
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            Text="P"/>
                    </FlexLayout>
                    <Label 
                        Text="{Binding PasswordConfirmErrors}"
                        TextColor="{StaticResource ErrorText}"
                        Margin="0, -15, 0, 0"/>
                    <Button
                        Text="Sign up"
                        CornerRadius="10"
                        Command="{Binding SignUpCommand}" />
                    <Label
                        HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    Text="Already have an account? "
                                    TextColor="Black" />
                                <Span
                                    Text="Sign in"
                                    TextColor="DarkCyan">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LogInLinkCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>