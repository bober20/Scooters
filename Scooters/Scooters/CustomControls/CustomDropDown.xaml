<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scooters.CustomControls.CustomDropDownView"
             xmlns:local="clr-namespace:Scooters.CustomControls"
             x:DataType="local:CustomDropDownView">
    <Border BackgroundColor="Aqua">
        <Grid RowDefinitions="Auto,Auto">
            <Grid
                Row="0"
                RowDefinitions="Auto"
                HeightRequest="20">
                <Border Grid.Row="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DropDownTappedCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Select string" />
                </Border>
                <AbsoluteLayout>
                    <AbsoluteLayout.Triggers>
                        <DataTrigger
                            TargetType="AbsoluteLayout"
                            Binding="{Binding IsDropDownOpen}"
                            Value="True">
                            <Setter
                                Property="IsVisible"
                                Value="True" />
                        </DataTrigger>
                    </AbsoluteLayout.Triggers>
                    <CollectionView
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        AbsoluteLayout.LayoutBounds="10,20,1,AutoSize"
                        BackgroundColor="Green"
                        ItemsSource="{Binding ItemsSource}">
                    </CollectionView>
                </AbsoluteLayout>
            </Grid>
            <Label
                Grid.Row="1"
                BackgroundColor="Transparent"
                Text="dfhkshfkh" />
        </Grid>
    </Border>
</ContentView>