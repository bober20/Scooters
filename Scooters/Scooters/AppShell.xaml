<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Scooters.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Scooters.Views"
    FlyoutBehavior="Disabled"
    Title="Scooters">
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />
    <ShellContent
        ContentTemplate="{DataTemplate views:SignUpPage}"
        Route="SignUpPage" />
    <TabBar>
        <ShellContent Title="Main" Icon="event.png" ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        <ShellContent Title="Map" Icon="map.png" ContentTemplate="{DataTemplate views:ScootersMapPage}" Route="ScootersMapPage" />
        <ShellContent Title="QR" Icon="qr.png" ContentTemplate="{DataTemplate views:QRScannerPage}" Route="QRScannerPage" />
        <ShellContent Title="Profile" Icon="profile.png" ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
    </TabBar>
</Shell>