<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Scooters.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Scooters.Views"
    FlyoutBehavior="Disabled"
    Title="Scooters">
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />
    <ShellContent
        ContentTemplate="{DataTemplate views:SignUpPage}"
        Route="SignUpPage" />
    <TabBar>
        <ShellContent Title="Main" ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        <ShellContent Title="Map" ContentTemplate="{DataTemplate views:ScootersMapPage}" Route="MapPage" />
        <ShellContent Title="QR" ContentTemplate="{DataTemplate views:QRScannerPage}" Route="QRScannerPage" />
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
    </TabBar>
</Shell>