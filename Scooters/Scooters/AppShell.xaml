<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Scooters.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Scooters.Views"
    FlyoutBehavior="Disabled"
    Title="Scooters">
    
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"/>
    
    <ShellContent
        ContentTemplate="{DataTemplate views:SignUpPage}"
        Route="SignUpPage"/>
    
    <TabBar>
        <Tab Title="Main">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Map">
            <ShellContent ContentTemplate="{DataTemplate views:ScootersMapPage}" Route="MapPage" />
        </Tab>
        <Tab Title="QR">
            <ShellContent ContentTemplate="{DataTemplate views:QRScannerPage}" Route="QRScannerPage" />
        </Tab>
        <Tab Title="Profile">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>
    
    
</Shell>
